build/
screenshot/
nametag/
video/
dist/
test/
*__pycache__/
*.log
*.DS_Store
*.prof
*.config_tmp.yaml
*config_custom.yaml
*.exe
*.spec

# Large asset folders removed from history — do not re-add.
maps/
media/
# Any git bundle backups (history-rewrite safety copies) — never commit these.
*.bundle
# Local recordings and generated replay videos are large and reproducible.
*.mp4

# Auto-generated absolute-path copies of data.yaml (train.py writes these).
ml/*.abs.yaml
# Cached base YOLO weights + training runs (large, regenerable).
ml/weights/
ml/runs/
# Stray base weights downloaded to cwd by ultralytics.
yolo*.pt

# Generated YOLO datasets (synthetic images/labels) — do not commit. Covers
# the default ml/dataset/ and any specialised set like ml/dataset_snails/.
# Keep the default dir structure via the .gitkeep files below.
ml/dataset*/**
!ml/dataset/
!ml/dataset/images/
!ml/dataset/images/train/
!ml/dataset/images/val/
!ml/dataset/labels/
!ml/dataset/labels/train/
!ml/dataset/labels/val/
!ml/dataset/**/.gitkeep

# Generated lie-detector YOLO samples (large and reproducible).
ml/lie_dataset/images/
ml/lie_dataset/labels/
ml/lie_dataset_v2*/
ml/lie_real_dataset/images/
ml/lie_real_reviewed/images/
ml/lie_manual_dataset/images/
ml/videos/

# Generated lie-identity listwise datasets (large and reproducible).
ml/lie_identity_dataset/

# Motion-ablation feature caches. Keep reports and small experimental models.
ml/lie_motion_ablation/*_augmented.csv
ml/lie_motion_ablation/online_smoke/

# Ultralytics caches and default run dirs (weights/plots; regenerable).
*.cache
runs/

# Local evaluation / replay artifacts are reproducible from ignored recordings.
log/lie_eval/
log/lie_vis/
log/lie_vis_*/
log/lie_error_analysis/
log/lie_manual_model_smoke/
log/lie_replay_*.csv

# Per-frame A/B replay artifacts. Keep the run reports and summary JSON files.
log/lie_ranker_ab_*/baseline/
log/lie_ranker_ab_*/ranker/
log/lie_ranker_ab_*/ranker_margin_*/
log/lie_ranker_ab_*/ranker_final/
log/lie_motion_ablation_*/margin_*/
log/lie_motion_ablation_*/final_visualizations/
# Per-frame identity-decision ablation CSVs. Keep reports and summaries.
log/lie_identity_decision_ablation_*/baseline/
log/lie_identity_decision_ablation_*/safety/
log/lie_identity_decision_ablation_*/state/
log/lie_identity_decision_ablation_*/state_safety/
log/lie_identity_decision_ablation_*/motion/
# Per-frame switch-event training captures. Keep compact metrics/models only.
log/lie_switch_event_*/raw/
log/lie_switch_event_*/replay/
log/lie_switch_event_*/gate*/
log/lie_switch_event_*/final/
log/lie_switch_event_*/default_compat/
log/lie_switch_event_*/gate*_summary.json
