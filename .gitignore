build/
screenshot/
nametag/
video/
dist/
test/
*__pycache__/
*.log
*.DS_Store
*.prof
*.config_tmp.yaml
*config_custom.yaml
*.exe
*.spec

# Large asset folders removed from history — do not re-add.
maps/
media/
# Any git bundle backups (history-rewrite safety copies) — never commit these.
*.bundle

# Auto-generated absolute-path copies of data.yaml (train.py writes these).
ml/*.abs.yaml
# Cached base YOLO weights + training runs (large, regenerable).
ml/weights/
ml/runs/
# Stray base weights downloaded to cwd by ultralytics.
yolo*.pt

# Generated YOLO datasets (synthetic images/labels) — do not commit.  Covers
# the default ml/dataset/ and any specialised set like ml/dataset_snails/.
# Keep the default dir structure via the .gitkeep files below.
ml/dataset*/**
!ml/dataset/
!ml/dataset/images/
!ml/dataset/images/train/
!ml/dataset/images/val/
!ml/dataset/labels/
!ml/dataset/labels/train/
!ml/dataset/labels/val/
!ml/dataset/**/.gitkeep